<?xml version="1.0" encoding="utf-8"?>
<!--
  Build settings for TritonVision.dll: include paths, defines, libraries.

  Dependency locations (not part of this repository):
    GrpcRoot   - gRPC install built with MSVC, Release, /MD
                 (contains include\grpcpp\grpcpp.h and lib\grpc++.lib)
    OpenCVRoot - OpenCV 5.0 Windows build folder
                 (contains include\opencv2 and x64\vc16\lib\opencv_world500.lib)

  Each one is taken from, in order:
    1. an MSBuild property:      msbuild ... /p:GrpcRoot=C:\deps\grpc\
    2. an environment variable:  TRITONVISION_GRPC_ROOT / TRITONVISION_OPENCV_ROOT
    3. the default layout:       ..\..\..\library\grpc-msvc\ and ..\..\..\library\opencv\build\
                                 (relative to this file)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <!-- Tv* are internal copies: a property passed with /p: cannot be modified, so the trailing slash is added here -->
    <TvGrpcRoot Condition="'$(GrpcRoot)' != ''">$(GrpcRoot)</TvGrpcRoot>
    <TvGrpcRoot Condition="'$(TvGrpcRoot)' == '' and '$(TRITONVISION_GRPC_ROOT)' != ''">$(TRITONVISION_GRPC_ROOT)</TvGrpcRoot>
    <TvGrpcRoot Condition="'$(TvGrpcRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\library\grpc-msvc\</TvGrpcRoot>
    <TvGrpcRoot>$([MSBuild]::EnsureTrailingSlash('$(TvGrpcRoot)'))</TvGrpcRoot>

    <TvOpenCVRoot Condition="'$(OpenCVRoot)' != ''">$(OpenCVRoot)</TvOpenCVRoot>
    <TvOpenCVRoot Condition="'$(TvOpenCVRoot)' == '' and '$(TRITONVISION_OPENCV_ROOT)' != ''">$(TRITONVISION_OPENCV_ROOT)</TvOpenCVRoot>
    <TvOpenCVRoot Condition="'$(TvOpenCVRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\library\opencv\build\</TvOpenCVRoot>
    <TvOpenCVRoot>$([MSBuild]::EnsureTrailingSlash('$(TvOpenCVRoot)'))</TvOpenCVRoot>

    <TvSrc>$(MSBuildThisFileDirectory)</TvSrc>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Third-party headers are "external": their warnings are not shown -->
    <ExternalIncludePath>$(TvGrpcRoot)include;$(TvOpenCVRoot)include;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(TvSrc)include;$(TvSrc)triton;$(TvSrc)generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <PreprocessorDefinitions>TRITONVISION_EXPORTS;CARES_STATICLIB;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4267;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- gRPC is available as a Release /MD build only, so every configuration uses /MD -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(TvGrpcRoot)lib;$(TvOpenCVRoot)x64\vc16\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Link order taken from gRPC's CMake targets (grpc++ -> grpc -> upb -> ... -> abseil) -->
      <AdditionalDependencies>opencv_world500.lib;grpc++.lib;grpc.lib;upb_json_lib.lib;upb_textformat_lib.lib;upb_lex_lib.lib;upb_reflection_lib.lib;upb_mini_descriptor_lib.lib;upb_descriptor_lib.lib;upb_wire_lib.lib;utf8_range_lib.lib;upb_message_lib.lib;upb_mini_table_lib.lib;upb_hash_lib.lib;upb_base_lib.lib;upb_mem_lib.lib;re2.lib;zlibstatic.lib;cares.lib;gpr.lib;ssl.lib;crypto.lib;address_sorting.lib;libprotobuf.lib;absl_log_internal_check_op.lib;absl_die_if_null.lib;absl_log_internal_conditions.lib;absl_log_internal_message.lib;absl_log_internal_nullguard.lib;absl_examine_stack.lib;absl_log_internal_format.lib;absl_log_internal_structured_proto.lib;absl_log_internal_proto.lib;absl_log_internal_log_sink_set.lib;absl_log_sink.lib;absl_flags_internal.lib;absl_flags_marshalling.lib;absl_flags_reflection.lib;absl_flags_config.lib;absl_flags_program_name.lib;absl_flags_private_handle_accessor.lib;absl_flags_commandlineflag.lib;absl_flags_commandlineflag_internal.lib;absl_log_initialize.lib;absl_log_internal_globals.lib;absl_log_globals.lib;absl_vlog_config_internal.lib;absl_log_internal_fnmatch.lib;absl_raw_hash_set.lib;absl_hash.lib;absl_city.lib;absl_low_level_hash.lib;absl_hashtablez_sampler.lib;absl_random_distributions.lib;absl_random_seed_sequences.lib;absl_random_internal_entropy_pool.lib;absl_random_internal_randen.lib;absl_random_internal_randen_hwaes.lib;absl_random_internal_randen_hwaes_impl.lib;absl_random_internal_randen_slow.lib;absl_random_internal_platform.lib;absl_random_internal_seed_material.lib;absl_random_seed_gen_exception.lib;absl_statusor.lib;absl_status.lib;absl_cord.lib;absl_cordz_info.lib;absl_cord_internal.lib;absl_cordz_functions.lib;absl_exponential_biased.lib;absl_cordz_handle.lib;absl_crc_cord_state.lib;absl_crc32c.lib;absl_crc_internal.lib;absl_crc_cpu_detect.lib;absl_leak_check.lib;absl_strerror.lib;absl_str_format_internal.lib;absl_synchronization.lib;absl_stacktrace.lib;absl_symbolize.lib;absl_debugging_internal.lib;absl_demangle_internal.lib;absl_demangle_rust.lib;absl_decode_rust_punycode.lib;absl_utf8_for_code_point.lib;absl_graphcycles_internal.lib;absl_kernel_timeout_internal.lib;absl_malloc_internal.lib;absl_tracing_internal.lib;absl_time.lib;absl_civil_time.lib;absl_time_zone.lib;libutf8_validity.lib;absl_strings.lib;absl_strings_internal.lib;absl_string_view.lib;absl_throw_delegate.lib;absl_int128.lib;absl_base.lib;absl_raw_logging_internal.lib;absl_log_severity.lib;absl_spinlock_wait.lib;advapi32.lib;iphlpapi.lib;ws2_32.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/ignore:4221 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- Stop early with a clear message when a dependency is missing -->
  <Target Name="TritonVisionCheckDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TvGrpcRoot)include\grpcpp\grpcpp.h')"
           Text="gRPC not found at '$(TvGrpcRoot)'. Set TRITONVISION_GRPC_ROOT (or /p:GrpcRoot=...) to your gRPC install folder. See README.md." />
    <Error Condition="!Exists('$(TvOpenCVRoot)include\opencv2\core.hpp')"
           Text="OpenCV not found at '$(TvOpenCVRoot)'. Set TRITONVISION_OPENCV_ROOT (or /p:OpenCVRoot=...) to the OpenCV 'build' folder. See README.md." />
  </Target>
</Project>
